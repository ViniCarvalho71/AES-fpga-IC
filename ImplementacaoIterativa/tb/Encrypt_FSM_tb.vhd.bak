
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

library work;
use work.aes_package.all;

entity Encrypt_FSM_tb is
end entity Encrypt_FSM_tb;

architecture sim of Encrypt_FSM_tb is

    signal key_in         : matrix(3 downto 0, 3 downto 0);
    signal data_block_in  : matrix(3 downto 0, 3 downto 0);
    signal data_block_out : matrix(3 downto 0, 3 downto 0);

    signal key_load : std_logic := '0';
    signal start    : std_logic := '0';
    signal done     : std_logic;
    signal busy     : std_logic;

    signal clk : std_logic := '0';
    signal rst : std_logic := '1';

    constant CLK_PERIOD : time := 10 ns;

begin

    ----------------------------------------------------------------
    -- Clock
    ----------------------------------------------------------------

    clk <= not clk after CLK_PERIOD / 2;

    ----------------------------------------------------------------
    -- DUT
    ----------------------------------------------------------------

    DUT : entity work.Encrypt_FSM
        port map (
            key_in         => key_in,
            data_block_in  => data_block_in,
            data_block_out => data_block_out,

            key_load       => key_load,

            start          => start,
            done           => done,
            busy           => busy,

            clk            => clk,
            rst            => rst
        );

    ----------------------------------------------------------------
    -- Stimulus
    ----------------------------------------------------------------

    stimulus : process

        variable timeout : boolean := false;

    begin

        ------------------------------------------------------------
        -- Inicialização
        ------------------------------------------------------------

        key_in        <= (others => (others => (others => '0')));
        data_block_in <= (others => (others => (others => '0')));

        rst <= '1';

        wait for 3 * CLK_PERIOD;

        wait until rising_edge(clk);
        rst <= '0';

        ------------------------------------------------------------
        -- Chave AES-128:
        --
        -- 00 01 02 03
        -- 04 05 06 07
        -- 08 09 0A 0B
        -- 0C 0D 0E 0F
        --
        -- Matriz organizada como matrix(coluna, linha)
        ------------------------------------------------------------

        key_in(0, 0) <= X"00";
        key_in(0, 1) <= X"01";
        key_in(0, 2) <= X"02";
        key_in(0, 3) <= X"03";

        key_in(1, 0) <= X"04";
        key_in(1, 1) <= X"05";
        key_in(1, 2) <= X"06";
        key_in(1, 3) <= X"07";

        key_in(2, 0) <= X"08";
        key_in(2, 1) <= X"09";
        key_in(2, 2) <= X"0A";
        key_in(2, 3) <= X"0B";

        key_in(3, 0) <= X"0C";
        key_in(3, 1) <= X"0D";
        key_in(3, 2) <= X"0E";
        key_in(3, 3) <= X"0F";

        ------------------------------------------------------------
        -- Texto claro:
        --
        -- 00 11 22 33
        -- 44 55 66 77
        -- 88 99 AA BB
        -- CC DD EE FF
        ------------------------------------------------------------

        data_block_in(0, 0) <= X"00";
        data_block_in(0, 1) <= X"11";
        data_block_in(0, 2) <= X"22";
        data_block_in(0, 3) <= X"33";

        data_block_in(1, 0) <= X"44";
        data_block_in(1, 1) <= X"55";
        data_block_in(1, 2) <= X"66";
        data_block_in(1, 3) <= X"77";

        data_block_in(2, 0) <= X"88";
        data_block_in(2, 1) <= X"99";
        data_block_in(2, 2) <= X"AA";
        data_block_in(2, 3) <= X"BB";

        data_block_in(3, 0) <= X"CC";
        data_block_in(3, 1) <= X"DD";
        data_block_in(3, 2) <= X"EE";
        data_block_in(3, 3) <= X"FF";

        ------------------------------------------------------------
        -- Carrega a chave e inicia a criptografia
        ------------------------------------------------------------

        wait until rising_edge(clk);

        key_load <= '1';
        start    <= '1';

        wait until rising_edge(clk);

        start    <= '0';
        key_load <= '0';

        ------------------------------------------------------------
        -- Aguarda a conclusão
        ------------------------------------------------------------

        for i in 0 to 2000 loop

            wait until rising_edge(clk);

            if done = '1' then
                timeout := false;
                exit;
            end if;

            if i = 2000 then
                timeout := true;
            end if;

        end loop;

        assert timeout = false
            report "TIMEOUT: Encrypt_FSM nao terminou"
            severity failure;

        ------------------------------------------------------------
        -- Verificação do resultado esperado
        --
        -- Esperado:
        -- 69 C4 E0 D8 6A 7B 04 30
        -- D8 CD B7 80 70 B4 C5 5A
        ------------------------------------------------------------

        assert data_block_out(0, 0) = X"69"
            report "Erro em output(0,0)"
            severity error;

        assert data_block_out(0, 1) = X"C4"
            report "Erro em output(0,1)"
            severity error;

        assert data_block_out(0, 2) = X"E0"
            report "Erro em output(0,2)"
            severity error;

        assert data_block_out(0, 3) = X"D8"
            report "Erro em output(0,3)"
            severity error;

        assert data_block_out(1, 0) = X"6A"
            report "Erro em output(1,0)"
            severity error;

        assert data_block_out(1, 1) = X"7B"
            report "Erro em output(1,1)"
            severity error;

        assert data_block_out(1, 2) = X"04"
            report "Erro em output(1,2)"
            severity error;

        assert data_block_out(1, 3) = X"30"
            report "Erro em output(1,3)"
            severity error;

        assert data_block_out(2, 0) = X"D8"
            report "Erro em output(2,0)"
            severity error;

        assert data_block_out(2, 1) = X"CD"
            report "Erro em output(2,1)"
            severity error;

        assert data_block_out(2, 2) = X"B7"
            report "Erro em output(2,2)"
            severity error;

        assert data_block_out(2, 3) = X"80"
            report "Erro em output(2,3)"
            severity error;

        assert data_block_out(3, 0) = X"70"
            report "Erro em output(3,0)"
            severity error;

        assert data_block_out(3, 1) = X"B4"
            report "Erro em output(3,1)"
            severity error;

        assert data_block_out(3, 2) = X"C5"
            report "Erro em output(3,2)"
            severity error;

        assert data_block_out(3, 3) = X"5A"
            report "Erro em output(3,3)"
            severity error;

        report "TESTE AES-128 FINALIZADO"
            severity note;

        wait;

    end process stimulus;

end architecture sim;